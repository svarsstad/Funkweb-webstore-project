<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Project_Frontend</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
  </PropertyGroup>

  <!-- Removed ProjectReference to backend so frontend will compile linked model sources directly -->

  <ItemGroup>
	<Compile Include="..\Project Backend\Services\CurrencyService.cs" Link="Services\CurrencyService.cs" />
    <Compile Include="..\Project Backend\Models\Order.cs" Link="Models\Order.cs" />
    <Compile Include="..\Project Backend\Models\User.cs" Link="Models\User.cs" />
    <Compile Include="..\Project Backend\Models\Product.cs" Link="Models\Product.cs" />
    <Compile Include="..\Project Backend\Models\SaveOrderRequest.cs" Link="Models\SaveOrderRequest.cs" />
	<None Update="appsettings.private.json">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\lib\bootstrap\dist\css\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="3.10.2" />
    <PackageReference Include="MongoDB.Driver" Version="3.11.2" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.3" />
  </ItemGroup>

</Project>
