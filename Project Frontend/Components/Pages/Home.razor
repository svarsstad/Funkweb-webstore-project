@page "/"
@rendermode InteractiveServer
@inject Project_Backend.Services.CurrencyService CurrencyService
@inject Project_Frontend.Services.PublicProductService ProductApi
<PageTitle>Reality Anchor Depot</PageTitle>

<section class="banner-container">
    <img src=@(imagePath+"/Images/Title.png") alt="The Reality Anchor Depot" class="banner-background" />
    <img src=@(imagePath+"/Images/Title_foreground.png") alt="" class="banner-overlay-tentacles" />
</section>

<!-- Currency Selector Controls -->
<div class="currency-selector">
    <label>SELECT CURRENCY SHIFT:</label>
    <select @onchange="OnCurrencyChanged" value="@selectedCurrency">
        <option value="Any">Any</option>
        <option value="CZK - IID">Imperial IID</option>
        <option value="SCR-P">Scrap-P (Reaver Bucks)</option>
        <option value="REA-P">Reaver-P</option>
        <option value="SPLI-C">Splice-C</option>
        <option value="IND-MET">Industrial Metal</option>
    </select>
</div>

@if (products == null)
{
    <div class="loading-state">
        <p>DECRYPTION IN PROGRESS... CONNECTING TO DEPOT MAINFRAME</p>
    </div>
}
else
{
   <div class="product-grid">

    @foreach (var item in products)
    {
        <div class="product-card">

            <div class="card-header">
                <span class="card-badge">@item.ProductCategory</span>
            </div>

            <div class="card-body">

                <h3 class="product-title">
                    @item.productName
                </h3>

                <div class="card-image-container">
                    <img src="@(imagePath + item.Images.ElementAt(0).Value)"
                         class="card-image" />
                </div>

                <div class="price-row">

                    @if (currencySymbolAny)
                    {
                        <span class="price-symbol">
                            @CurrencyService.GetCreditSymbol(item.Curruency)
                        </span>

                        <span class="price-amount">
                            @item.Price.ToString("N2")
                        </span>
                    }
                    else
                    {
                        <span class="price-symbol">
                            @CurrencyService.GetCreditSymbol(selectedCurrency)
                        </span>

                        <span class="price-amount">
                            @CurrencyService
                                .ExchangePrice(
                                    (double)item.Price,
                                    item.Curruency,
                                    selectedCurrency)
                                .ToString("N2")
                        </span>
                    }

                </div>

                <button class="action-btn buy-btn"
                        type="button"
                        onclick="alert('Item purchased!')">
                    PURCHASE ITEM
                </button>

            </div>

        </div>
    }

</div>
}
@inject IConfiguration Configuration
@code {

    private List<Project_Backend.Models.Product>? products;
    private string selectedCurrency = "Any";
    private bool currencySymbolAny = true;

    private string? imagePath;

    protected override async Task OnInitializedAsync()
    {
        imagePath = Configuration["ImagePath"];
        products = await ProductApi.GetAllProductsAsync();
        await UpdateCurrencyData(selectedCurrency);
    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        if(e.Value?.ToString() == "Any")
        {
            currencySymbolAny = true;
        }
        else
        {
            currencySymbolAny = false;
        }
        selectedCurrency = e.Value?.ToString() ?? "Any";
        await UpdateCurrencyData(selectedCurrency);
    }

    private async Task UpdateCurrencyData(string currencyCode)
    {
        //currencySymbol = await CurrencyApi.GetCreditSymbolAsync(currencyCode);
        //exchangeRate = await CurrencyApi.GetExchangeRateAsync(currencyCode);
    }
}