@page "/"
@rendermode InteractiveServer
@inject Project_Backend.Services.CurrencyService CurrencyService
@inject Project_Frontend.Services.PublicProductService publicProductService
@inject Project_Frontend.Services.CartStateService cartService
<PageTitle>Reality Anchor Depot</PageTitle>

<section class="banner-container">
    <img src=@(imagePath + "/Images/Title.png") alt="The Reality Anchor Depot" class="banner-background" />
    <img src=@(imagePath + "/Images/Title_foreground.png") alt="" class="banner-overlay-tentacles" />
</section>

<!-- Currency Selector Controls -->
<div class="currency-selector">
    <label>SELECT CURRENCY SHIFT:</label>
    <select @onchange="OnCurrencyChanged" value="@selectedCurrency">
        <option value="Any">Any</option>
        <option value="CZK - IID">Imperial IID</option>
        <option value="SCR-P">Scrap-P (Reaver Bucks)</option>
        <option value="REA-P">Reaver-P</option>
        <option value="SPLI-C">Splice-C</option>
        <option value="IND-MET">Industrial Metal</option>
    </select>
</div>

@if (products == null)
{
    <div class="loading-state">
        <p>DECRYPTION IN PROGRESS... CONNECTING TO DEPOT MAINFRAME</p>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var item in products.Select((value, i) => new { i, value }))
        {
            <div class="product-card">

                <div class="card-header">
                    <span class="card-badge">@item.value.ProductCategory</span>
                </div>

                <div class="card-body">

                    <h3 class="product-title">
                        @item.value.productName
                    </h3>

                    <div class="card-image-container">
                        <img src="@(imagePath + item.value.Images.First().Value)"
                             class="card-image" />
                    </div>

                    <div class="price-row">

                        @if (currencySymbolAny)
                        {
                            <span class="price-symbol">
                                @CurrencyService.GetCreditSymbol(item.value.Curruency)
                            </span>

                            <span class="price-amount">
                                @item.value.Price.ToString("N2")
                            </span>
                        }
                        else
                        {
                            <span class="price-symbol">
                                @CurrencyService.GetCreditSymbol(selectedCurrency)
                            </span>

                            <span class="price-amount">
                                @CurrencyService
                                .ExchangePrice(
                                (double)item.Price,
                                item.Curruency,
                                selectedCurrency)
                                .ToString("N2")
                            </span>
                        }

                    </div>
                    @if (itemQuantity == null || itemQuantity[item.i] == 0)
                    {
                        <button class="action-btn buy-btn"
                                type="button"
                                @onclick="() => addProductqty(item.value.Id, item.i, 1)">
                            PURCHASE ITEM
                        </button>
                    }
                    else
                    {
                        <button class="action-btn buy-btn-minus"
                                type="button"
                                @onclick="() => addProductqty(item.value.Id, item.i, -1)">
                            -
                        </button>

                        <!-- Standard HTML input instead of InputNumber -->
                        <input type="number"
                               class="cart-qty-input"
                               min="0"
                               value="@itemQuantity[item.i]"
                               @onchange="(e) => updateProductqty(item.value.Id, item.i, itemQuantity[item.i])" />

                        <button class="action-btn buy-btn-plus"
                                type="button"
                                @onclick="() => addProductqty(item.value.Id, item.i, 1)">
                            +
                        </button>
                    }

                </div>

            </div>
        }

    </div>
}
@inject IConfiguration Configuration
@code {

    public List<Project_Backend.Models.Product>? products;
    private string selectedCurrency = "Any";
    private bool currencySymbolAny = true;
    private int[]? itemQuantity = null;
    private string? imagePath;

    protected override async Task OnInitializedAsync()
    {
        imagePath = Configuration["ImagePath"];
        products = await publicProductService.GetAllProductsAsync();
        itemQuantity = new int[products.Count];
        foreach (var item in products.Select((value, i) => new { i, value }))
        {
            itemQuantity[item.i] = cartService.FindItem(item.value.Id);
        }

    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        if (e.Value?.ToString() == "Any")
        {
            currencySymbolAny = true;
        }
        else
        {
            currencySymbolAny = false;
        }
        selectedCurrency = e.Value?.ToString() ?? "Any";

    }

    private async void addProductqty(string id, int i, int qty)
    {
        if (itemQuantity == null || i < 0 || i >= itemQuantity.Length)
        {
            return;
        }
        Project_Backend.Models.Product? newProduct = await publicProductService.GetProductByIdAsync(id);

        // 2. Safely check for null before adding
        if (newProduct != null)
        {
            cartService.addQuantity(newProduct, publicProductService, qty);
            itemQuantity[i] += qty;
        }
        else
        {
            // Handle case where product was not found (e.g., log error or alert user)
        }
        InvokeAsync(StateHasChanged);
    }
    private void updateProductqty(string id, int i, int qty)
    {
        if (itemQuantity == null || i < 0 || i >= itemQuantity.Length)
        {
            return;
        }
        cartService.UpdateQuantity(id, qty, publicProductService);
        itemQuantity[i] = qty;
        InvokeAsync(StateHasChanged);
    }
}