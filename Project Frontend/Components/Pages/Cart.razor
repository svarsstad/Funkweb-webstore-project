@page "/cart"
@rendermode InteractiveServer
@implements IDisposable
@inject Project_Frontend.Services.CartStateService CartState
@inject Project_Frontend.Services.PublicProductService publicProductService
@inject IConfiguration Configuration

<PageTitle>Cart // Reality Anchor Depot</PageTitle>

<div class="cart-wrapper">
    <div class="cart-header">
        <h1 class="cart-title">SLOT INVENTORY <span class="cart-badge">[@CartState.TotalCount ITEMS]</span></h1>
    </div>

    @if (!CartState.Items.Any())
    {
        <div class="empty-cart-card">
            <div class="empty-icon">⚠️</div>
            <h2>DATA SLOT EMPTY</h2>
            <p>No gear or void tech detected in active buffer.</p>
            <a href="/catalog" class="action-btn browse-btn">BROWSE CATALOG</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items-list">
                @foreach (var item in CartState.Items)
                {
                    <div class="cart-item-card">
                        <div class="item-media">
                            @if (item.Product.Images != null && item.Product.Images.Any())
                            {
                                <img src="@(imagePath+ item.Product.Images.First().Value)" alt="@item.Product.productName" class="item-img" />                    
                            }
                        </div>

                        <div class="item-details">
                            <span class="item-style">@item.Product.ProductStyle.ToUpper()</span>
                            <h3 class="item-name">@item.Product.productName</h3>
                        </div>

                        <div class="item-quantity">
                            <button class="qty-btn" @onclick="() => UpdateQuantity(item.Product, -1, publicProductService)">-</button>
                            <span class="qty-val">@item.Quantity</span>
                            <button class="qty-btn" @onclick="() => UpdateQuantity(item.Product, 1, publicProductService)">+</button>
                        </div>

                        <div class="item-pricing">
                            <div class="line-total">@((item.Product.Price * item.Quantity).ToString("N0")) CREDITS</div>
                        </div>

                        <button class="remove-btn" @onclick="() => RemoveItem(item.Product.Id)">×</button>
                    </div>
                }

                <button class="purge-btn" @onclick="CartState.ClearCart">PURGE ALL ITEMS</button>
            </div>

            <!-- Summary Card -->
            <div class="cart-summary-card">
                <h2 class="summary-title">TRANSMISSION SUMMARY</h2>
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span>@CartState.SubTotal.ToString("N0") CREDITS</span>
                </div>
                <div class="summary-row total-row">
                    <span>TOTAL REQUIRED</span>
                    <span class="total-price">@((CartState.SubTotal * 1.05m).ToString("N0")) CREDITS</span>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string? imagePath = "";
    protected override void OnInitialized()
    {
        imagePath = Configuration["ImagePath"];
        CartState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CartState.OnChange -= StateHasChanged;
    }
    public void UpdateQuantity(Project_Backend.Models.Product product, int qty,Project_Frontend.Services.PublicProductService publicProductService)
    {
        CartState.addQuantity(product, publicProductService, qty);
        if(CartState.FindItem(product.Id) <= 0)
        {
            CartState.RemoveItem(product.Id);
        }
        InvokeAsync(StateHasChanged);
    }
    public void RemoveItem(string Id)
    {
        CartState.RemoveItem(Id);
        InvokeAsync(StateHasChanged);
    }
}