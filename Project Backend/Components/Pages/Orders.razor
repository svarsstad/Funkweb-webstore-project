@page "/orders"
@rendermode InteractiveServer
@using Project_Backend.Models
@using Project_Backend.Services

@inject ProductService ProductService
@inject OrderService OrderService
@inject CurrencyService CurrencyService
@inject UserService UserService
@code {

    private List<Order>? orders;
    /// <summary>
    /// search filter phrase written into class: search-box
    /// </summary>
    private string OrderSearch = "";
    private Order? selectedOrder;
    private string currentUserName = "";
    private OrderItem? selectedProduct = null;

    private List<string> statuses = new()
    {
        "Pending Payment",
        "Processing",
        "Shipped",
        "Delivered",
        "Cancelled"
    };

    protected override async Task OnInitializedAsync()
    {
        orders = await OrderService.GetAllOrdersAsync();
        await ProductService.GetAllProductsAsync();
        if (ProductService.Products == null || ProductService.Products.Count == 0)
        {
            return;
        }
        foreach (Order order in orders)
        {
            foreach (OrderItem item in order.Items)
            {
                foreach (var product in ProductService.Products)
                {
                    if (item.ProductId == product.Id)
                    {
                        item.ProductName = product.productName;
                        break;
                    }
                }
                if (item.ProductId == null)
                {
                    item.ProductName = "Unknown Product";
                    continue;
                }
            }
        }
    }

    private async Task SelectOrder(Order order)
    {
        selectedProduct = null;
        selectedOrder = order;
        if (order.UserId != null)
        {
            currentUserName = await UserService.GetUserName(order.UserId);
        }
    }
    private void SelectProduct(OrderItem product)
    {
        selectedProduct = product;
    }

    private async Task OnStatusChanged(ChangeEventArgs e, Order order)
    {
        var newStatus = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(newStatus))
        {
            order.OrderStatus = newStatus;

            await OrderService.UpdateOrderStatusAsync(
                order.Id!,
                newStatus);
        }
    }
    private async Task DeleteOrder(Order order)
    {
        await OrderService.DeleteOrderAsync(order.Id!);
        orders?.Remove(order);
    }
    private void ClearOrderFilter()
    {
        OrderSearch = "";
    }
}

<PageTitle>Orders</PageTitle>

<h1>Orders</h1>

@if (orders == null || orders.Count() < 1)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="order-layout">
        <div class="orders-list">
            <div class="filter-bar">
                <input class="search-box"
                       placeholder="Search orders..."
                       @bind="OrderSearch" />
                <button class="clear-filter-btn"
                        @onclick="ClearOrderFilter"
                        disabled="@string.IsNullOrWhiteSpace(OrderSearch)">
                    ✕
                </button>
            </div>
            <table class="table">

                <thead>
                    <tr>
                        <th>Order Id</th>
                        <th>Client Id</th>
                        <th>Date</th>
                        <th>Price</th>
                        <th>Products</th>
                        <th>Status</th>
                        <th>🗑</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var order in orders.Where(
                        u =>
                        (
                            u.Id != null &&
                            u.UserId != null) &&
                            (
                                string.IsNullOrWhiteSpace(OrderSearch) ||
                                u.Id.Contains(OrderSearch, StringComparison.OrdinalIgnoreCase) ||
                                u.UserId.Contains(OrderSearch, StringComparison.OrdinalIgnoreCase) ||
                                u.Items.Any(item => item.ProductName != null && item.ProductName.Contains(OrderSearch, StringComparison.OrdinalIgnoreCase))
                            )
                        )
                    )
                    {
                        <tr class="order-row @(selectedOrder?.Id == order.Id ? "selected-order" : "")"
                            @onclick="(() => SelectOrder(order))">

                            <td>@order.Id</td>

                            @if (string.IsNullOrWhiteSpace(order.UserId))
                            {
                                <td>TEST</td>
                            }
                            else
                            {
                                <td>@order.UserId</td>
                            }

                            <td>@order.OrderDate</td>

                            <td>@order.TotalOrderValue@CurrencyService.GetCreditSymbol(" ")</td>

                            <td>@order.Items.Count()</td>

                            <td>

                                <select value="@order.OrderStatus"
                                        @onchange="(e => OnStatusChanged(e, order))">

                                    @foreach (var status in statuses)
                                    {
                                        <option value="@status">
                                            @status
                                        </option>
                                    }

                                </select>

                            </td>
                            <td class="delete-cell">

                                @if (selectedOrder?.Id == order.Id)
                                {
                                    <button class="delete-btn"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => DeleteOrder(order)">
                                        🗑
                                    </button>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>
    </div>
}

<div class="order-details">

    @if (selectedOrder == null)
    {
        <p>Select an order.</p>
    }
    else
    {
        <h2>Order Details</h2>
        <div>
            <p>
                <strong>Order:</strong>
                @selectedOrder.Id
            </p>

            <p>
                <strong>Status:</strong>
                @selectedOrder.OrderStatus
            </p>

            <p>
                <strong>Total:</strong>
                @selectedOrder.TotalOrderValue
            </p>
        </div>
        <div>
            <p>
                <strong>Client:</strong>
                @currentUserName
            </p>


        </div>
        <h3>Items</h3>

        <table class="table">

            <thead>
                <tr>
                    <th>Product Id</th>
                    <th>Product Name</th>
                    <th>Quantity</th>
                </tr>
            </thead>

            <tbody>

                @foreach (OrderItem item in selectedOrder.Items)
                {
                    <tr class="order-details-row @(selectedProduct?.ProductId == item.ProductId ? "selected-order" : "")"
                        @onclick="(() => SelectProduct(item))">
                        <td>@item.ProductId</td>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                    </tr>
                }

            </tbody>

        </table>
    }

</div>

