@page "/orders"
@rendermode InteractiveServer
@using Project_Backend.Models
@using Project_Backend.Services
@inject OrderService OrderService
<PageTitle>Orders</PageTitle>

<h1>Orders</h1>
@if (orders == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th aria-label="Order Id">Order Id</th>
                <th aria-label="Client Id">Client Id</th>
                @* <th aria-label="Product Name">Product</th> *@
                <th aria-label="Date">Date</th>
                <th aria-label="Price">Price</th>
                <th aria-label="Products">Products</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td>@order.Id</td>
                    @if (order.UserId == null ||order.UserId == string.Empty)
                    {
                        <td>Test</td>
                    }
                    else{
                        <td>@order.UserId</td>
                    }
                    @* <td>@order.ProductName</td> *@
                    <td>@order.OrderDate</td>
                    <td>@order.TotalOrderValue</td>
                    <td>@order.Items.Count()</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    private List<Order>? orders;

    // This runs automatically when the page loads
    protected override async Task OnInitializedAsync()
    {
        orders = await OrderService.GetAllOrdersAsync();
    }

}
