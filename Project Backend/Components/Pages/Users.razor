@page "/users"
@rendermode InteractiveServer
@using Project_Backend.Models
@using Project_Backend.Services
@inject UserService UserService

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<p class="users-subtitle">
    This component shows users logged in the system
</p>

@if (users == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="users-list">

        <table class="table">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Display Name</th>
                    <th>Email</th>
                    <th>Orders</th>
                    <th>Last Login</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var user in users)
                {
                    <tr class="user-row @(selectedUser?.Id == user.Id ? "selected-user" : "")"
                        @onclick="(() => SelectUser(user))">

                        <td>@user.Id</td>

                        <td>@user.DisplayName</td>

                        <td>@user.Email</td>

                        <td>@user.Orders.Count()</td>

                        <td>@user.LastLogin.ToString("yyyy-MM-dd HH:mm")</td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

@code {

    private List<User>? users;

    private User? selectedUser;

    protected override async Task OnInitializedAsync() => users = await UserService.GetAllUsersAsync();

    private void SelectUser(User user)
    {
        selectedUser = user;
    }
}