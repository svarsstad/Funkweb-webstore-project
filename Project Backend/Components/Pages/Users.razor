@page "/users"
@rendermode InteractiveServer
@using Project_Backend.Models
@using Project_Backend.Services
@inject UserService UserService
@inject IJSRuntime RefreshHelper




<PageTitle>Users</PageTitle>

<div class="users-header">

    <div>
        <h1>Users</h1>
        <p>This component shows users logged in the system</p>

    </div>
    <div>
        <button class="rfr-btn"
                @onclick="ForceReloadUsers">
            ↻ Refresh
        </button>
    </div>
    <div class="selected-user-preview">

        @if (selectedUser != null
        && !string.IsNullOrWhiteSpace(selectedUser.UserImage))
        {
            <img src="@selectedUser.UserImage"
                 class="selected-user-image" />
        }

    </div>

</div>

@if (users == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="users-list">

        <table class="table">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Display Name</th>
                    <th>Privilege</th>
                    <th>Email</th>
                    <th>Orders</th>
                    <th>Last Login</th>
                    <th>🗑</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var user in users)
                {
                    <tr class="user-row @(selectedUser?.Id == user.Id ? "selected-user" : "")"
                        @onclick="(() => SelectUser(user))">

                        <td>@user.Id</td>

                        <td>@user.DisplayName</td>
                        <td>@user.Privilege</td>
                        <td>@user.Email</td>

                        <td>@user.Orders.Count()</td>

                        <td>@user.LastLogin.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="delete-cell">

                            @if (selectedUser?.Id == user.Id)
                            {
                                <button class="delete-btn"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => DeleteUser(user)">
                                    🗑
                                </button>
                            }

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
}

@code {

    private List<User>? users;

    private User? selectedUser;

    protected override async Task OnInitializedAsync() => await LoadUsers();

    private void SelectUser(User user)
    {
        selectedUser = user;
    }
    private async Task DeleteUser(User user)
    {
        await UserService.DeleteUserAsync(user.Id!);
        users?.Remove(user);
    }
    private async Task LoadUsers()
    {

        users = await UserService.GetAllUsersAsync();
        StateHasChanged();

    }
    private async Task ForceReloadUsers()
    {
      
        users = await UserService.GetAllUsersForceReloadAsync();
        StateHasChanged();
 
    }

    private DotNetObjectReference<Users>? objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);

            await RefreshHelper.InvokeVoidAsync(
                "registerRefreshKey",
                objRef);
        }
    }

    [JSInvokable]
    public async Task RefreshData()
    {

        await ForceReloadUsers();

    }
}