@page "/add_product"
@rendermode InteractiveServer
@using Project_Backend.Helpers
@using Project_Backend.Models
@using Project_Backend.Services
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms

@inject ProductService ProductService
@inject IWebHostEnvironment Env

<PageTitle>Add Product</PageTitle>

<div class="page-container">

    <h1>Add Product</h1>

    <div class="editor-layout">
        <!-- LEFT -->
        <div class="panel">
            <div class="panel-title">
                Product JSON
            </div>
            <textarea class="json-area"
                      @bind="JsonText"
                      placeholder="Paste product JSON here..."></textarea>

            <InputFile OnChange="HandleJsonFile"
                       accept=".json"
                       class="theme-file-input" />

        </div>

        <!-- RIGHT -->
        <div class="panel">

            <div class="panel-title">
                Product Images
            </div>

            <div class="image-viewer">

                @if (PreviewImages.Count > 0)
                {
                    <img src="@PreviewImages[currentImageIndex]"
                         class="preview-image" />
                }
                else
                {
                    <div class="no-image">
                        No images selected
                    </div>
                }

            </div>

            <div class="image-controls">

                <button class="nav-btn"
                        @onclick="PreviousImage">
                    Previous
                </button>

                <button class="nav-btn-next"
                        @onclick="NextImage">
                    Next
                </button>
            </div>
            <div>
                <InputFile OnChange="HandleImages"
                           accept="image/*"
                           multiple
                           class="theme-file-input" />
            </div>

        </div>

    </div>

    @if (CanSaveProduct())
    {
        <div class="save-row">

            @if (!SaveSuccessful)
            {
                <button class="save-btn"
                        @onclick="SaveProduct">

                    Save Product

                </button>
            }
            else
            {
                <button class="save-btn"
                        @onclick="ClearProduct">

                    Saved - Clear Form

                </button>
            }

        </div>
    }

</div>

@code {

    private Product TempProduct = new();

    private string JsonText = "";

    private bool SaveSuccessful = false;
    private List<string> TempImagePaths = new();
    private readonly List<string> PreviewImages = new();

    private int currentImageIndex = 0;
    private async Task HandleJsonFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var reader =
            new StreamReader(file.OpenReadStream());

        JsonText = await reader.ReadToEndAsync();

        await ParseJson();

        await InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        CleanupTempImages();
    }

    private async Task HandleImages(InputFileChangeEventArgs e)
    {
        CleanupTempImages();
        var files = e.GetMultipleFiles();

        var tempFolder =
            Path.Combine(
                Env.WebRootPath,
                "tempImages");

        if (!Directory.Exists(tempFolder))
        {
            Directory.CreateDirectory(tempFolder);
        }

        foreach (var file in files)
        {
            var extension =
                Path.GetExtension(file.Name);

            var fileName =
                $"{Guid.NewGuid()}{extension}";

            var fullPath =
                Path.Combine(tempFolder, fileName);

            await using var stream =
                new FileStream(fullPath, FileMode.Create);

            await file.OpenReadStream(
                maxAllowedSize: 1024 * 1024 * 50)
                .CopyToAsync(stream);

            var relativePath =
                $"/tempImages/{fileName}";

            TempImagePaths.Add(relativePath);

            PreviewImages.Add(relativePath);
        }

    }

    private async Task SaveProduct()
    {
        if (!CanSaveProduct())
            return;

        try
        {
            var options =
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };

            var parsedProduct =
                JsonSerializer.Deserialize<Product>(
                    JsonText,
                    options);

            if (parsedProduct == null)
                return;


            var finalFolder =
                Path.Combine(
                    Env.WebRootPath,
                    "Images");

            if (!Directory.Exists(finalFolder))
            {
                Directory.CreateDirectory(finalFolder);
            }

            int index = 0;

            foreach (var tempPath in TempImagePaths)
            {
                var fileName =
                    Path.GetFileName(tempPath);

                var oldPath =
                    Path.Combine(
                        Env.WebRootPath,
                        "TempImages",
                        fileName);

                var newPath =
                    Path.Combine(
                        finalFolder,
                        fileName);

                File.Move(oldPath, newPath);

                TempProduct.Images.Add(
                    index++,
                    $"/Images/{fileName}");
            }

            TempProduct = parsedProduct;

            await ProductService.CreateProductAsync(TempProduct);

            SaveSuccessful = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task ParseJson()
    {
        if (string.IsNullOrWhiteSpace(JsonText))
            return;

        try
        {
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

            var product =
                JsonSerializer.Deserialize<Product>(
                    JsonText,
                    options);

            if (product == null)
                return;

            ProductHelper.ApplyNonImageChanges(
                TempProduct,
                product);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void ClearProduct()
    {
        TempProduct = new Product();

        JsonText = "";

        foreach (var tempPath in TempImagePaths)
        {
            var fileName =
                Path.GetFileName(tempPath);

            var fullPath =
                Path.Combine(
                    Env.WebRootPath,
                    "TempImages",
                    fileName);

            if (File.Exists(fullPath))
            {
                File.Delete(fullPath);
            }
        }

        TempImagePaths.Clear();

        SaveSuccessful = false;
    }

    private void NextImage()
    {
        if (PreviewImages.Count == 0)
            return;

        currentImageIndex++;

        if (currentImageIndex >= PreviewImages.Count)
        {
            currentImageIndex = 0;
        }
    }

    private void PreviousImage()
    {
        if (PreviewImages.Count == 0)
            return;

        currentImageIndex--;

        if (currentImageIndex < 0)
        {
            currentImageIndex =
                PreviewImages.Count - 1;
        }
    }

    private bool CanSaveProduct()
    {
        return
            !string.IsNullOrWhiteSpace(JsonText)
            && PreviewImages.Count > 0;
    }

    private void CleanupTempImages()
    {
        var tempFolder =
            Path.Combine(
                Env.WebRootPath,
                "TempImages");

        if (!Directory.Exists(tempFolder))
            return;

        var files =
            Directory.GetFiles(tempFolder);

        foreach (var file in files)
        {
            var created =
                File.GetCreationTimeUtc(file);

            if (DateTime.UtcNow - created
                > TimeSpan.FromHours(1))
            {
                try
                {
                    File.Delete(file);
                }
                catch
                {
                    // ignore locked files
                }
            }
        }
    }
}

