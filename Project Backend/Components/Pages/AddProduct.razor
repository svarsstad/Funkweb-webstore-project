@page "/add_product"
@using Project_Backend.Models
@using Project_Backend.Services
@using Project_Backend.Helpers
@using System.Text.Json
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject ProductService ProductService
@inject OrderService OrderService
@inject IWebHostEnvironment Env
<div class="page">

    <div class="title">
        Add Product
    </div>

    <div class="split">

        <!-- LEFT -->
        <div class="drop-panel"
             @ondragover="PreventDefault"
             @ondragenter="PreventDefault"
             @ondrop="HandleJsonDrop"
             @ondrop:preventDefault
             @ondragover:preventDefault>

            <div class="drop-title">
                Product JSON
            </div>

            <div class="drop-subtitle">
                Drop JSON file or paste raw JSON
            </div>

            <textarea class="json-area"
                      @bind="JsonText"
                      placeholder="Paste product JSON here..."></textarea>

            <InputFile OnChange="HandleJsonFile"
                       class="file-input"
                       accept=".json" />

            @if (JsonLoaded)
            {
                <div class="status">
                    JSON loaded successfully
                </div>
            }

        </div>

        <!-- RIGHT -->
        <div class="drop-panel"
             @ondragover="PreventDefault"
             @ondragenter="PreventDefault"
             @ondrop="HandleImageDrop"
             @ondrop:preventDefault
             @ondragover:preventDefault>

            <div class="drop-title">
                Product Images
            </div>

            <div class="drop-subtitle">
                Drop one or more images
            </div>

            <InputFile OnChange="HandleImages"
                       multiple
                       accept="image/*"
                       class="file-input" />

            <div class="image-grid">

                @foreach (var image in PreviewImages)
                {
                    <div class="image-preview">
                        <img src="@image" />
                    </div>
                }

            </div>

            @if (ImagesLoaded)
            {
                <div class="status">
                    @TempProduct.Images.Count images loaded
                </div>
            }

        </div>

    </div>

    @if (canSaveProduct())
    {
        <div class="button-row">
            @if (!SaveSuccessful)
            {
                <button class="save-btn"
                        @onclick="ClearProduct">

                    Saved, clear?

                </button>
            }
            )
            else{
            <button class="save-btn"
                    @onclick="SaveProduct">

                Add Product

            </button>
            }

        </div>
    }
</div>
@code {

    private Product TempProduct = new();

    private string JsonText = "";

    private bool JsonLoaded;
    private bool ImagesLoaded;
    private bool SaveSuccessful;

    private List<string> PreviewImages = new();

    private void ClearProduct()
    {
        TempProduct = new Product();
        JsonText = "";
        JsonLoaded = false;
        ImagesLoaded = false;
        SaveSuccessful = false;
        PreviewImages.Clear();
    }
    private async Task SaveProduct()
    {
        if (!canSaveProduct())
            return;
        SaveSuccessful = true;
        await ProductService.CreateProductAsync(TempProduct);
        
    }

    private async Task HandleJsonFile(InputFileChangeEventArgs e)
    {
        var file = e.File;

        using var reader = new StreamReader(file.OpenReadStream());

        JsonText = await reader.ReadToEndAsync();

        await ParseJson();
    }

    private async Task ParseJson()
    {
        Product? product = null;
        if (string.IsNullOrWhiteSpace(JsonText))
            return;

        try
        {
            var options = new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };

            product = JsonSerializer.Deserialize<Product>(JsonText, options);
        }
        catch (JsonException ex)
        {
            Console.WriteLine($"JSON parse failed: {ex.Message}");

        }

        if (product == null)
            return;

        JsonLoaded = ProductHelper.ApplyNonImageChanges(TempProduct, product);

        await InvokeAsync(StateHasChanged);


    }

    private async Task HandleImages(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles();

        var imageFolder =
            Path.Combine(Env.WebRootPath, "Images");

        if (!Directory.Exists(imageFolder))
        {
            Directory.CreateDirectory(imageFolder);
        }

        int index = 0;

        foreach (var file in files)
        {
            var extension =
                Path.GetExtension(file.Name);

            var fileName =
                $"{Guid.NewGuid()}{extension}";

            var fullPath =
                Path.Combine(imageFolder, fileName);

            using var stream =
                new FileStream(fullPath, FileMode.Create);

            await file.OpenReadStream().CopyToAsync(stream);

            var relativePath =
                $"/Images/{fileName}";

            // Product.Images is a Dictionary<int, string> in the Product model
            TempProduct.Images.Add(index++, relativePath);

            PreviewImages.Add(relativePath);
        }

        ImagesLoaded = true;
    }

    private bool canSaveProduct()
    {
        return JsonLoaded && ImagesLoaded;
    }

    private void PreventDefault(DragEventArgs e)
    {
    }

    private async Task HandleJsonDrop(DragEventArgs e)
    {
        // Optional JS enhancement later
        await ParseJson();
    }

    private async Task HandleImageDrop(DragEventArgs e)
    {
        // Optional JS enhancement later
        await Task.CompletedTask;
    }

}
