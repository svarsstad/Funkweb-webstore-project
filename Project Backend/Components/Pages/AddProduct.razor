@page "/add_product"
@rendermode InteractiveServer
@using Project_Backend.Helpers
@using Project_Backend.Models
@using Project_Backend.Services
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms

@inject ProductService ProductService
@inject IWebHostEnvironment Env

<PageTitle>Add Product</PageTitle>

<div class="page-container">

    <h1>Add Product</h1>

    <div class="editor-layout">
        <!-- LEFT -->
        <div class="panel">
            <div class="panel-title">
                Product JSON
            </div>
            <textarea class="json-area"
                      @bind="JsonText"
                      placeholder="Paste product JSON here..."></textarea>

            <InputFile OnChange="HandleJsonFile"
                       accept=".json"
                       class="theme-file-input" />

        </div>

        <!-- RIGHT -->
        <div class="panel">

            <div class="panel-title">
                Product Images
            </div>

            <div class="image-viewer">

                @if (PreviewImages.Count > 0)
                {
                    <img src="@PreviewImages[currentImageIndex]"
                         class="preview-image" />
                }
                else
                {
                    <div class="no-image">
                        No images selected
                    </div>
                }

            </div>

            <div class="image-controls">

                <button class="nav-btn"
                        @onclick="PreviousImage">
                    Previous
                </button>

                <button class="nav-btn-next"
                        @onclick="NextImage">
                    Next
                </button>
            </div>
            <div>
                <InputFile OnChange="HandleJsonFile"
                           accept=".json"
                           class="theme-file-input" />
            </div>

        </div>

    </div>

    @if (CanSaveProduct())
    {
        <div class="save-row">

            @if (!SaveSuccessful)
            {
                <button class="save-btn"
                        @onclick="SaveProduct">

                    Save Product

                </button>
            }
            else
            {
                <button class="save-btn"
                        @onclick="ClearProduct">

                    Saved - Clear Form

                </button>
            }

        </div>
    }

</div>

@code {

    private Product TempProduct = new();

    private string JsonText = "";

    private bool SaveSuccessful = false;

    private readonly List<string> PreviewImages = new();

    private int currentImageIndex = 0;
    private async Task HandleJsonFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var reader =
            new StreamReader(file.OpenReadStream());

        JsonText = await reader.ReadToEndAsync();

        await ParseJson();

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleImages(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles();

        var imageFolder =
            Path.Combine(Env.WebRootPath, "Images");

        if (!Directory.Exists(imageFolder))
        {
            Directory.CreateDirectory(imageFolder);
        }

        TempProduct.Images.Clear();
        PreviewImages.Clear();

        int index = 0;

        foreach (var file in files)
        {
            var extension =
                Path.GetExtension(file.Name);

            var fileName =
                $"{Guid.NewGuid()}{extension}";

            var fullPath =
                Path.Combine(imageFolder, fileName);

            using var stream =
                new FileStream(fullPath, FileMode.Create);

            await file.OpenReadStream()
                .CopyToAsync(stream);

            var relativePath =
                $"/Images/{fileName}";

            TempProduct.Images.Add(index, relativePath);

            PreviewImages.Add(relativePath);

            index++;
        }

        currentImageIndex = 0;
    }

    private async Task SaveProduct()
    {
        if (!CanSaveProduct())
            return;

        try
        {
            var options =
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };

            var parsedProduct =
                JsonSerializer.Deserialize<Product>(
                    JsonText,
                    options);

            if (parsedProduct == null)
                return;

            parsedProduct.Images =
                TempProduct.Images;

            TempProduct = parsedProduct;

            await ProductService.CreateProductAsync(TempProduct);

            SaveSuccessful = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task ParseJson()
    {
        if (string.IsNullOrWhiteSpace(JsonText))
            return;

        try
        {
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

            var product =
                JsonSerializer.Deserialize<Product>(
                    JsonText,
                    options);

            if (product == null)
                return;

            ProductHelper.ApplyNonImageChanges(
                TempProduct,
                product);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void ClearProduct()
    {
        TempProduct = new Product();

        JsonText = "";

        PreviewImages.Clear();

        currentImageIndex = 0;

        SaveSuccessful = false;
    }

    private void NextImage()
    {
        if (PreviewImages.Count == 0)
            return;

        currentImageIndex++;

        if (currentImageIndex >= PreviewImages.Count)
        {
            currentImageIndex = 0;
        }
    }

    private void PreviousImage()
    {
        if (PreviewImages.Count == 0)
            return;

        currentImageIndex--;

        if (currentImageIndex < 0)
        {
            currentImageIndex =
                PreviewImages.Count - 1;
        }
    }

    private bool CanSaveProduct()
    {
        return
            !string.IsNullOrWhiteSpace(JsonText)
            && PreviewImages.Count > 0;
    }
}

