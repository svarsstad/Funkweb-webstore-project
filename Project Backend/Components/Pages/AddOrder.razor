@page "/add_order"
@rendermode InteractiveServer
@using Project_Backend.Helpers
@using Project_Backend.Models
@using Project_Backend.Services
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms

@inject CurrencyService CurrencyService
@inject UserService UserService
@inject ProductService ProductService
@inject OrderService OrderService
@inject IWebHostEnvironment Env

<PageTitle>Add Order</PageTitle>

@if (Users == null || Products == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="order-layout">
        <div class="users-list">
            <div class="filter-bar">
            <input class="search-box"
                   placeholder="Search users..."
                   @bind="UserSearch" />
            <button class="clear-filter-btn"
                    @onclick="ClearUserFilter"
                    disabled="@string.IsNullOrWhiteSpace(UserSearch)">
                ✕
            </button>
            </div>
            <table class="table">

                <thead>
                    <tr>
                        <th>Display Name</th>
                        <th>Email</th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Users.Where(u =>
                        string.IsNullOrWhiteSpace(UserSearch) ||
                        u.Email.Contains(UserSearch, StringComparison.OrdinalIgnoreCase) ||
                        u.DisplayName.Contains(UserSearch, StringComparison.OrdinalIgnoreCase)))
                    {
                        <tr class="user-row @(SelectedUser?.Id == user.Id ? "selected-user" : "")"
                            @onclick="(() => SelectUser(user))">
                            <td>@user.DisplayName</td>
                            <td>@user.Email</td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
        <div class="products-list">
            <div class="filter-bar">
                <input class="search-box"
                       placeholder="Search products..."
                       @bind="ProductSearch" />

                <button class="clear-filter-btn"
                        @onclick="ClearProductFilter"
                        disabled="@string.IsNullOrWhiteSpace(ProductSearch)">
                    ✕
                </button>
            </div>
            <table class="table">

                <thead>
                    <tr>
                        <th>Product Id</th>
                        <th>Name</th>
                        @if (SelectedProduct != null)
                        {
                            <th>
                                <div class="qty-cell">
                                    <span>-</span>
                                    <span>Quantity</span>
                                    <span>+</span>
                                </div>
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>

                    @foreach (var product in Products.Where(p =>
                        string.IsNullOrWhiteSpace(ProductSearch) ||
                        p.Id.Contains(ProductSearch, StringComparison.OrdinalIgnoreCase) ||
                        p.productName.Contains(ProductSearch, StringComparison.OrdinalIgnoreCase)))
                    {
                        <tr class="product-row @(SelectedProduct?.Id == product.Id ? "selected-product" : "")"
                            @onclick="(() => SelectProduct(product))">
                            <td>@product.Id</td>
                            <td>@product.productName</td>
                            @if (SelectedProduct != null && SelectedProduct == product)
                            {
                                <td>
                                    <div class="qty-cell">
                                        <button class="minus-btn"
                                             @onclick:stopPropagation ="true"
                                             @onclick="() => SubProductFromOrder(SelectedProduct)">
                                            -
                                        </button>

                                        <InputNumber TValue="int" @bind-Value="currentQuantity" @bind-Value:after="() => HandleQtyChange(SelectedProduct, currentQuantity)" class="quantity-input" />

                                        <button
                                            class="plus-btn"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => AddProductToOrder(SelectedProduct)">
                                            +
                                        </button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>
    <div class="orderItem-list">

        <table class="table">

            <thead>
                <tr>
                    <th>Product Id</th>
                    <th>Name</th>
                    <th>Quantity</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var OItem in OrderItems)
                {

                    <tr class="product-row @(SelectedOrderItem?.ProductId == OItem.ProductId ? "selected-product" : "")"
                        @onclick="(() => SelectOrderItem(OItem))">
                        <td>@OItem.ProductId</td>
                        <td>@OItem.ProductName</td>
                        <td>@OItem.Quantity</td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
    <div>
        @if (SelectedUser != null && OrderItems.Count > 0 && !OrderSaved)
        {
            <button class="save-btn" @onclick="SaveOrder">Save Order</button>
        }
        else if (OrderSaved)
        {
            <button class="save-btn" @onclick="ResetOrder">Order saved, reset?</button>
        }
    </div>
}


@code {

    private List<User> Users = new();
    private List<Product> Products = new();
    private List<OrderItem> OrderItems = new();

    private User? SelectedUser;
    private Product? SelectedProduct;
    private OrderItem? SelectedOrderItem;
    private int currentQuantity = 0;
    private bool OrderSaved = false;
    private string UserSearch = "";
    private string ProductSearch = "";

    protected override async Task OnInitializedAsync()
    {
        Users = await UserService.GetAllUsersAsync();
        Products = await ProductService.GetAllProductsAsync();
    }

    private void SelectUser(User user)
    {
        SelectedUser = user;
    }
    private void SelectProduct(Product product)
    {
        SelectedProduct = product;
        currentQuantity = 0;
        foreach (OrderItem oItem in OrderItems)
        {
            if (oItem.ProductId == product.Id && SelectedProduct.Id == product.Id)
            {
                currentQuantity = oItem.Quantity;
            }
        }
    }
    private void SelectOrderItem(OrderItem orderItem)
    {
        SelectedOrderItem = orderItem;
        foreach (Product product in Products)
        {
            if (product.Id == orderItem.ProductId)
            {
                SelectedProduct = product;
                ProductSearch = product.productName;
                currentQuantity = orderItem.Quantity;
            }
        }
    }
    private void AddProductToOrder(Product Item)
    {
        bool found = false;

        foreach (var oItem in OrderItems)
        {
            if (oItem.ProductId == Item.Id)
            {
                oItem.Quantity++;
                found = true;
                currentQuantity = oItem.Quantity;
                break;
            }
        }

        if (!found)
        {
            OrderItems.Add(new OrderItem(Item.Id, 1, (double)Item.Price, 0, Item.productName));
            currentQuantity = 1;
        }
    }

    private void SubProductFromOrder(Product orderItem)
    {
        foreach (var oItem in OrderItems)
        {
            if (oItem.ProductId == orderItem.Id)
            {
                oItem.Quantity--;
                currentQuantity = oItem.Quantity;
            }
            if (oItem.Quantity <= 0)
            {
                OrderItems.Remove(oItem);
                currentQuantity = 0;
            }
        }
    }

    private async Task SaveOrder()

    {
        List<double> prices = new();
        foreach (var item in OrderItems)
        {
            prices.Add((double)Products.First(p => p.Id == item.ProductId).Price);
            prices[prices.Count - 1] -= prices[prices.Count - 1] * item.DiscountPercentage * 0.01;
            foreach (Product product in Products)
            {
                if (product.Id == item.ProductId && !product.Curruency.StartsWith("CZK-IID"))
                {
                    prices[prices.Count - 1] *= CurrencyService.GetExchangeRate(product.Curruency);
                }
            }
            prices[prices.Count - 1] *= item.Quantity;
        }

        SaveOrderRequest orderRequest = new SaveOrderRequest(SelectedUser?.Id, OrderItems.ToArray<OrderItem>(), prices.ToArray<double>());
        await OrderService.SaveOrderAsync(orderRequest);
        OrderSaved = true;
    }
    private void ResetOrder()
    {
        SelectedUser = null;
        SelectedProduct = null;
        SelectedOrderItem = null;
        OrderItems.Clear();
        currentQuantity = 0;
        OrderSaved = false;
    }
    private void HandleQtyChange(Product product, int CurrentQty)
    {
        if (CurrentQty < 1) { return; }

        AddProductToOrder(product);

        foreach (OrderItem oItem in OrderItems)
        {
            if (oItem.ProductId == product.Id)
            {
                oItem.Quantity = CurrentQty;
                break;
            }
        }
        currentQuantity = CurrentQty;
    }
    private void ClearProductFilter()
    {
        ProductSearch = "";
    }
    private void ClearUserFilter()
    {
        UserSearch = "";
    }

}
